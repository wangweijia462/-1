% ================================================================
% land_finance_dsge.mod
% Dynare代码：房地产下行周期中的土地财政DSGE模块
% 对应论文第四节动态扩展（公式4.7—4.21）
% 运行环境：Dynare 5.x + Matlab/Octave
% 编译命令：dynare land_finance_dsge.mod
% ================================================================

var
  % ---- 价格变量 ----
  q        $q$           % 名义住房价格（对数偏离稳态）
  ph       $p^h$         % 实际住房价格
  pl       $p^\ell$      % 实际工资（对数）

  % ---- 数量变量 ----
  IS       ${IS}$        % 全国住宅库存率 IS/H
  S        $S$           % 开发商新增住房供给
  Dh       $D^h$         % 住房需求
  Y        $Y$           % 实际GDP（对数）
  A        $A$           % 全要素生产率（对数）
  G        $G$           % 地方政府公共投入（对数，加权均值）
  PiG      $\Pi^G$       % 土地出让收入（对数）
  c        $c$           % 居民消费（对数）
  lam      $\lambda$     % 消费边际效用（拉格朗日乘数）

  % ---- 债务 ----
  Debt     $D$           % 地方政府债务率

  % ---- 利率 ----
  r        $r$           % 无风险实际利率
;

varexo
  eps_q    $\varepsilon^q$     % 聚合房价冲击
  eps_G    $\varepsilon^G$     % 土地出让收入冲击
  eps_A    $\varepsilon^A$     % TFP基础冲击
  eps_r    $\varepsilon^r$     % 货币政策/利率冲击
;

parameters
  BETA     $\beta$       % 折现因子
  ETA      $\eta$        % 住房支出份额
  ALPHA    $\alpha$      % 劳动产出弹性
  RHO      $\rho$        % 财政-TFP弹性
  GAMMA    $\gamma$      % 库存-价格弹性
  RHO_Q    $\rho_q$      % 房价自回归系数
  RHO_G    $\rho_G$      % 土地收入自回归系数
  RHO_A    $\rho_A$      % TFP自回归系数
  R_D      $r_D$         % 债务利率
  S_G      $s_G$         % 土地收入占公共投入稳态份额
  DEL_IS   $\delta_{IS}$ % 库存折旧率
  THETA    $\theta$      % 政府土地收益截取比例
  SIG_Q    $\sigma_q$    % 房价冲击标准差
  SIG_G    $\sigma_G$    % 财政冲击标准差
  SIG_A    $\sigma_A$    % TFP冲击标准差
;

% ================================================================
%% 参数赋值（对应表1）
% ================================================================
BETA   = 0.96;
ETA    = 0.13;
ALPHA  = 0.67;
RHO    = 0.103;
GAMMA  = 0.08;
RHO_Q  = 0.75;
RHO_G  = 0.80;
RHO_A  = 0.85;
R_D    = 0.045;
S_G    = 0.40;
DEL_IS = 0.15;
THETA  = 0.60;
SIG_Q  = 0.030;    % 年化3%房价冲击标准差
SIG_G  = 0.025;
SIG_A  = 0.015;

% ================================================================
%% 模型方程
% ================================================================
model;

% ---- 1. 消费欧拉方程（对应公式4.7）----
exp(-c) = BETA*(1+r(+1))*exp(-c(+1));

% ---- 2. 拉格朗日乘数定义 ----
lam = exp(-c);

% ---- 3. 住房需求欧拉方程（对应公式4.8）----
% ETA/h_t = lam*(q_t - BETA*E[q_{t+1}])
% 对数线性化：ETA*(1-h) = lam*(q - BETA*q(+1))
ETA*(1 - exp(-q)) = lam*(q - BETA*q(+1));

% ---- 4. 房价动态方程（对应公式4.14）----
q = RHO_Q*q(-1) - GAMMA*IS + eps_q;

% ---- 5. 库存动态（对应公式4.12）----
IS = (1-DEL_IS)*IS(-1) + S - Dh;

% ---- 6. 住房需求（来自公式4.5）----
% D^h = eta * w * L / q ≈ ETA*exp(pl-q) （对数近似）
Dh = ETA*(exp(pl) - exp(q));

% ---- 7. 开发商供给（零利润条件，公式4.13简化）----
% S与房价正相关，与土地成本负相关
S = exp(q) - (1-S_G)*exp(PiG) - R_D*Debt;

% ---- 8. 土地出让收入动态（对应公式4.17）----
% Pi_G随房价同向波动：Pi_G = theta*q*Rh + ...
PiG = RHO_G*PiG(-1) + (1-RHO_G)*(THETA*q) + eps_G;

% ---- 9. 公共投入动态（对应公式4.19）----
G = PiG - R_D*Debt(-1);

% ---- 10. TFP动态（财政-TFP渠道，对应公式4.9）----
% A = A*^{1-rho} * G^{rho}  对数：a = (1-rho)*a_star + rho*g
A = RHO_A*A(-1) + RHO*G + eps_A;

% ---- 11. 实际工资（由生产函数FOC，公式4.10）----
pl = A + (1-ALPHA)*(0-pl);
% 简化：w_i = alpha * A_i * (Ry/L)^{1-alpha}，稳态Ry/L=1

% ---- 12. GDP（生产函数，公式4.5）----
Y = A + ALPHA*pl;

% ---- 13. 债务动态（对应公式4.20）----
Debt = (1+R_D)*Debt(-1) + exp(G) - exp(PiG);

% ---- 14. 实际住房价格 ----
ph = q;   % 静态：ph = q（名义与实际之比为1）

% ---- 15. 均衡利率（泰勒规则或固定）----
r = R_D + eps_r;

end;

% ================================================================
%% 稳态值（稳态点为对数偏离=0）
% ================================================================
initval;
  q      = 0;
  ph     = 0;
  pl     = 0;
  IS     = 0.12;    % 稳态库存率12%
  S      = 0.018;
  Dh     = 0.018;
  Y      = 0;
  A      = 0;
  G      = 0;
  PiG    = 0;
  c      = 0;
  lam    = 1;
  Debt   = 0.60;    % 稳态债务率60%
  r      = 0.04;
end;

steady;
check;

% ================================================================
%% 冲击设定：七项反事实实验的冲击参数
% ================================================================
shocks;
  % 实验1：房价下降10%（一次性冲击）
  var eps_q = SIG_Q^2;

  % 实验2：土地出让收入下降30%
  var eps_G = SIG_G^2;

  % 实验3：TFP基础冲击
  var eps_A = SIG_A^2;

  % 利率冲击（货币政策）
  var eps_r; stderr 0.005;
end;

% ================================================================
%% 脉冲响应分析（40期，对应10年）
% ================================================================
stoch_simul(order=1,
            periods=1000,
            irf=40,
            graph_format=eps,
            nograph)
  Y A G PiG q IS Debt c;

% ================================================================
%% 方差分解（输出各冲击对GDP方差的贡献）
% ================================================================
% 结果存储于oo_.variance_decomposition
% 预期：eps_G对Y方差贡献约60%（与论文实验2结论一致）

% ================================================================
%% 情景1专项冲击：房价下降10%（确定性冲击）
% ================================================================
% 将以下代码在基准模型校准后单独运行：
%
% shocks;
%   var eps_q;
%   periods 1;
%   values -0.10;
% end;
% simul(periods=40);
% dY_exp1 = (oo_.endo_simul(strmatch('Y',M_.endo_names,'exact'),:) ...
%            - oo_.steady_state(strmatch('Y',M_.endo_names,'exact')))*100;
% fprintf('实验1：GDP变化 = %.3f%%\n', dY_exp1(1));

% ================================================================
%% 情景2专项冲击：土地出让收入下降30%
% ================================================================
% shocks;
%   var eps_G;
%   periods 1;
%   values -0.30;
% end;
% simul(periods=40);
